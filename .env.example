# Strategy generation provider. Defaults to "local", a deterministic generator
# that needs no network access and no key — the app, the test suite and a fresh
# clone all run without this file.
STRATEGY_PROVIDER=local

# Set STRATEGY_PROVIDER=openai and supply a key to use a hosted model instead.
# Read only inside the route handler; never exposed to the browser bundle.
# STRATEGY_API_KEY=sk-...
# STRATEGY_MODEL=gpt-4o-mini
# STRATEGY_BASE_URL=https://api.openai.com/v1
# STRATEGY_TIMEOUT_MS=20000
